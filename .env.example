# Postgres connection using the restricted chatbot_readonly role
# (SELECT-only on products/categories/product_images)
DATABASE_URL=postgresql://chatbot_readonly:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Shared secret the frontend must send in the X-API-Key header
CHATBOT_API_KEY=change-me

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
